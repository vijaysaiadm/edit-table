# ── LLM provider ────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Together,
# Groq, a local vLLM/Ollama server, etc.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Fallback model (used for cheap per-scene workers if set)
LLM_MODEL_WORKER=

# ── Pipeline tuning ─────────────────────────────────────────────
# Max parallel LLM calls for scene workers / utility workers
MAX_CONCURRENCY=6
# Minutes of screen time assumed per screenplay page (industry default 1)
MINUTES_PER_PAGE=1.0
